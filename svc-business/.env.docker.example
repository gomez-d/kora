# Application
PORT=8000
ALLOWED_HOSTS=*

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=business_user
DB_NAME=kora_business

# Internal services
IDENTITY_SERVICE_URL=http://svc-identity:8000
