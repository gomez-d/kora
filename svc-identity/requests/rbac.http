# ==========================================
# KORA IDENTITY - RBAC TESTS
# ==========================================

@baseUrl = http://localhost:8001/api/rbac

# ==========================================
# 1. ROLES
# ==========================================

### 1.1 Create Role
POST {{baseUrl}}/roles/
Content-Type: application/json

{
    "name": "Admin",
    "description": "Administrator role"
}

### 1.2 Get All Roles
GET {{baseUrl}}/roles/

### 1.3 Get Role by ID
@roleId = ebddd293-39b4-4a66-ba95-d7d27e902a9b
GET {{baseUrl}}/roles/{{roleId}}/

### 1.4 Update Role (PUT)
PUT {{baseUrl}}/roles/{{roleId}}/
Content-Type: application/json

{
    "name": "Admon",
    "description": "System administrator role"
}

### 1.5 Partial Update Role (PATCH)
PATCH {{baseUrl}}/roles/{{roleId}}/
Content-Type: application/json

{
    "description": "Updated administrator role"
}

# ==========================================
# 2. PERMISSIONS
# ==========================================

### 2.1 Create Permission
POST {{baseUrl}}/permissions/
Content-Type: application/json

{
    "name": "View Users",
    "resource": "users",
    "action": "read",
    "description": "Allows viewing users"
}

### 2.2 Get All Permissions
GET {{baseUrl}}/permissions/

### 2.3 Get Permission by ID
@permissionId = 5eeaae94-1702-4fac-9724-6e01bcac59ff
GET {{baseUrl}}/permissions/{{permissionId}}/

### 2.4 Update Permission (PUT)
PUT {{baseUrl}}/permissions/{{permissionId}}/
Content-Type: application/json

{
    "name": "Manage Users",
    "resource": "users",
    "action": "manage",
    "description": "Allows managing users"
}

### 2.5 Partial Update Permission (PATCH)
PATCH {{baseUrl}}/permissions/{{permissionId}}/
Content-Type: application/json

{
    "description": "Updated user management permission"
}

# ==========================================
# 3. USER ROLES
# ==========================================

### 3.1 Assign Role to User
@userId = 10c271ce-4075-4606-9a56-ef2f0fbd0155

POST {{baseUrl}}/user-roles/
Content-Type: application/json

{
    "user": "{{userId}}",
    "role": "{{roleId}}"
}

### 3.2 Get All User Role Assignments
GET {{baseUrl}}/user-roles/

### 3.3 Get User Role Assignment by ID
@userRoleId = 3c192b11-a604-4eb6-aa21-34afd2af168f
GET {{baseUrl}}/user-roles/{{userRoleId}}/

### 3.4 Remove Role from User
DELETE {{baseUrl}}/user-roles/{{userRoleId}}/

# ==========================================
# 4. ROLE PERMISSIONS
# ==========================================

### 4.1 Assign Permission to Role
POST {{baseUrl}}/role-permissions/
Content-Type: application/json

{
    "role": "{{roleId}}",
    "permission": "{{permissionId}}"
}

### 4.2 Get All Role Permission Assignments
GET {{baseUrl}}/role-permissions/

### 4.3 Get Role Permission Assignment by ID
@rolePermissionId = 866e3155-ad8e-47eb-8172-1c8b3658470d
GET {{baseUrl}}/role-permissions/{{rolePermissionId}}/

### 4.4 Remove Permission from Role
DELETE {{baseUrl}}/role-permissions/{{rolePermissionId}}/

# ==========================================
# 5. CLEANUP
# ==========================================

### 5.1 Delete Permission
DELETE {{baseUrl}}/permissions/{{permissionId}}/

### 5.2 Delete Role
DELETE {{baseUrl}}/roles/{{roleId}}/